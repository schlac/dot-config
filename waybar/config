{
    "layer": "top",
    "spacing": 0,
    "height": 0,

    "margin-top": 10,
    "margin-right": 10,
    "margin-bottom": 0,
    "margin-left": 10,

    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "tray",
        "hyprland/language",
        "cpu_text",
        "cpu",
        "memory",
        "battery",
        "network",
        "pulseaudio",
        "custom/control"
    ],

    "custom/launcher":{
        "format": " ",
        "on-click": "rofi -show drun",
        "on-click-right": "killall rofi",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "tooltip": false
    },

    "tray": {
        "spacing": 10,
        "tooltip": false
    },

    "clock": {
        "format": "{:%H:%M - %a, %d %b %Y}",
        "tooltip": false
    },

    "cpu": {
        "format": "cpu {usage}%",
        "interval": 3,
        "states": {
            "critical": 90
        }
    },

    "memory": {
        "format": "mem {percentage}%",
        "interval": 3,
        "states": {
            "critical": 80
        }
    },

    "battery": {
        "format-time": "{H}:{M:02}",
        "format": "bat {capacity}% ({time})",
        "format-charging": "bat {capacity}% ({time})",
        "format-charging-full": "bat {capacity}%",
        "format-full": "bat {capacity}%",
        "format-alt": "bat {power}W",
        "format": "bat {icon}{capacity}%",
        "interval": 10,
        "states": {
            "warning": 30,
            "critical": 10
        },
        "tooltip": false
    },

    "network": {
        "interval": 5,
        "format-wifi": "wifi {essid} ({signalStrength}%)",
        "format-ethernet": "eth {ifname}",
        "format-disconnected": "no network",
        "format-alt": "net {ipaddr}/{cidr}",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "{icon}vol {volume}%",
        "format-bluetooth": "{icon}vol {volume}%",
        "format-muted": "vol",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", ""]
        },
        "scroll-step": 1,
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "tooltip": false
    },

    "hyprland/language": {
        "format": "{short}",
    },

    "custom/control":{
        "format": " ",
        "on-click": "control",
        "on-click-right": "killall control",
        "tooltip": false
    },
}
